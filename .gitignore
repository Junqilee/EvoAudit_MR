# Python and local environments
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env
.env.*

# External datasets and cloned third-party projects stay local
external/

# Hidden/offline evaluator inputs contain private seeds and are never committed
configs/*_offline.json

# Full historical experiment trees are preserved in archives/ and kept local
# after extraction; use RESULTS_README.md for the archive and checksum.
artifacts/
artifacts_*/

# Local IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local logs and scratch files
*.log
*.tmp

# ICLR paper build outputs (source files remain tracked)
paper/*.aux
paper/*.log
paper/*.out
paper/*.pdf
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
